{
  "manifest_version": 2,
  "name": "Whitelist URL Blocker",
  "description": "Blocks navigation to all URLs except those in a user-defined whitelist.",
  "version": "1.0",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "storage",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Whitelist URLs",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    "blocked.html"
  ]
}